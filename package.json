{
  "name": "appwrite-canary-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Appwrite Sites canary — Node pilot",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-dist-health.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preflight": "npm run typecheck && npm run lint && npm test",
    "observability-check": "bash scripts/observability-check.sh",
    "test:data": "vitest run src/lib/tasks.test.ts src/lib/lists.test.ts src/lib/taskPayload.test.ts src/lib/attachments.test.ts src/lib/taskView.test.ts src/lib/share.test.ts functions/share-task"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "appwrite": "^21.0.0",
    "express": "^5.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
